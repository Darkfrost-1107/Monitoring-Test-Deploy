  <div class="seccion">DATOS DEL(OS) MONITOR(ES):</div>
  <table class="datos">
    <tr>
      <td class="l" colspan="3">APELLIDOS Y NOMBRES:</td>
      <td colspan="9">
        <span class="fuerte">{{monitor.nombre}}</span>
        <span class="monitor-opciones">
          DREP <span class="caja-x{{#if monitor.drep}} marcada{{/if}}">{{#if monitor.drep}}X{{/if}}</span> UGEL <span class="caja-x{{#if monitor.ugel}} marcada{{/if}}">{{#if monitor.ugel}}X{{/if}}</span> DIRECTOR IE <span class="caja-x{{#if monitor.directorIe}} marcada{{/if}}">{{#if monitor.directorIe}}X{{/if}}</span> COORDINADOR <span class="caja-x{{#if monitor.coordinador}} marcada{{/if}}">{{#if monitor.coordinador}}X{{/if}}</span>
        </span>
      </td>
    </tr>
    <tr>
      <td class="l" colspan="1">DNI:</td><td colspan="2">{{monitor.dni}}</td>
      <td class="l" colspan="1">E-MAIL:</td><td colspan="4" class="correo">{{monitor.correo}}</td>
      <td class="l" colspan="2">N° CELULAR:</td><td colspan="2">{{monitor.celular}}</td>
    </tr>
  </table>

  <div class="seccion">FECHA Y DURACIÓN:</div>
  <table class="datos">
    <tr>
      <td class="l" colspan="1">FECHA:</td><td colspan="3">{{fecha}}</td>
      <td class="l" colspan="2">HORA INICIO:</td><td colspan="2">{{horaInicio}}</td>
      <td class="l" colspan="2">HORA FINAL:</td><td colspan="2">{{horaFinal}}</td>
    </tr>
  </table>

  <div class="seccion centrada">NIVELES DEL LOGRO:</div>
  <table>
    <tr>{{#each niveles}}<td class="relleno">NIVEL {{this.romano}}</td>{{/each}}</tr>
    <tr>{{#each niveles}}<td class="centro">{{this.denominacion}}</td>{{/each}}</tr>
  </table>

