<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Ficha de monitoreo al docente</title>
  {{> estilos-oficial}}
</head>
<body>
<table class="envoltura">
{{> banner-oficial}}
<tbody><tr><td>

  <div class="titulo">FICHA DE MONITOREO AL DOCENTE {{anio}}</div>

  <div class="seccion">DATOS DE LA INSTITUCIÓN EDUCATIVA:</div>
  <table class="datos">
    <tr><td class="l" colspan="2">UGEL:</td><td colspan="10">UGEL LAMPA</td></tr>
    <tr><td class="l" colspan="2">INSTITUCIÓN EDUCATIVA:</td><td class="fuerte" colspan="10">{{institucion.nombre}}</td></tr>
    <tr>
      <td class="l" colspan="2">MODALIDAD:</td><td colspan="2">{{institucion.modalidad}}</td>
      <td class="l" colspan="2">NIVEL:</td><td colspan="2">{{institucion.nivel}}</td>
      <td class="l" colspan="2">ÁREA:</td><td colspan="2">{{docente.area}}</td>
    </tr>
    <tr><td class="l" colspan="4">APELLIDOS Y NOMBRES DEL DIRECTOR(A):</td><td class="fuerte" colspan="8">{{director.nombre}}</td></tr>
    <tr>
      <td class="l" colspan="1">DNI:</td><td colspan="2">{{director.dni}}</td>
      <td class="l" colspan="1">E-MAIL:</td><td colspan="4" class="correo">{{director.correo}}</td>
      <td class="l" colspan="2">N° CELULAR:</td><td colspan="2">{{director.celular}}</td>
    </tr>
    <tr>
      <td class="l" colspan="2">ENCARGADO:</td><td class="chk" colspan="2"><span class="caja-x{{#if director.encargado}} marcada{{/if}}">{{#if director.encargado}}X{{/if}}</span></td>
      <td class="l" colspan="2">DESIGNADO:</td><td class="chk" colspan="2"><span class="caja-x{{#if director.designado}} marcada{{/if}}">{{#if director.designado}}X{{/if}}</span></td>
      <td class="l" colspan="2">ENC. X FUNCIONES:</td><td class="chk" colspan="2"><span class="caja-x{{#if director.porFunciones}} marcada{{/if}}">{{#if director.porFunciones}}X{{/if}}</span></td>
    </tr>
  </table>

  <div class="seccion">DATOS DEL DOCENTE MONITOREADO:</div>
  <table class="datos">
    <tr><td class="l" colspan="4">APELLIDOS Y NOMBRES DEL DOCENTE:</td><td class="fuerte" colspan="8">{{docente.nombre}}</td></tr>
    <tr>
      <td class="l" colspan="1">DNI:</td><td colspan="2">{{docente.dni}}</td>
      <td class="l" colspan="1">E-MAIL:</td><td colspan="4" class="correo">{{docente.correo}}</td>
      <td class="l" colspan="2">N° CELULAR:</td><td colspan="2">{{docente.celular}}</td>
    </tr>
    <tr>
      <td class="l" colspan="2">CONTRATADO:</td><td class="chk" colspan="2"><span class="caja-x{{#if docente.contratado}} marcada{{/if}}">{{#if docente.contratado}}X{{/if}}</span></td>
      <td class="l" colspan="2">NOMBRADO:</td><td class="chk" colspan="2"><span class="caja-x{{#if docente.nombrado}} marcada{{/if}}">{{#if docente.nombrado}}X{{/if}}</span></td>
      <td class="l" colspan="2">OTRO:</td><td class="chk" colspan="2"><span class="caja-x{{#if docente.otro}} marcada{{/if}}">{{#if docente.otro}}X{{/if}}</span></td>
    </tr>
    <tr>
      <td class="l" colspan="2">MODALIDAD:</td><td colspan="2">{{docente.modalidad}}</td>
      <td class="l" colspan="2">NIVEL:</td><td colspan="2">{{docente.nivel}}</td>
      <td class="l" colspan="2">ÁREA:</td><td colspan="2">{{docente.area}}</td>
    </tr>
    <tr>
      <td class="l" colspan="2">GRADO:</td><td colspan="1">{{docente.grado}}</td>
      <td class="l" colspan="2">SECCIÓN:</td><td colspan="1">{{docente.seccion}}</td>
      <td class="l" colspan="3">CANT. ESTUDIANTES:</td><td colspan="1">{{docente.estudiantes}}</td>
      <td class="l" colspan="1">NEE</td><td colspan="1">{{docente.nee}}</td>
    </tr>
  </table>

  {{> monitor-fecha-niveles-oficial}}

  <div class="lineamiento">LINEAMIENTO 2: Docentes mejoran su desempeño a través de la formación continua para lograr el nivel satisfactorio en el logro de los aprendizajes</div>
  <div class="aula">OBSERVACIÓN DE AULA</div>

  {{> rubricas-oficial}}


  {{#if planificacion.length}}
  <div class="bloque">
  <div class="seccion" style="margin-top:14px;">PLANIFICACIÓN Y DISEÑO DE EVALUACIÓN</div>
  <table class="plan">
    <tr>
      <th rowspan="2" style="width:5%">R</th>
      <th rowspan="2" style="width:28%">EJES E ITEMS</th>
      <th colspan="4">NIVEL DE LOGRO</th>
      <th rowspan="2">EVIDENCIAS</th>
    </tr>
    <tr><th style="width:5%">I</th><th style="width:5%">II</th><th style="width:5%">III</th><th style="width:5%">IV</th></tr>
    {{#each planificacion}}
    <tr>
      <td class="r">{{this.numero}}</td>
      <td class="eje">{{this.descripcion}}</td>
      {{#each this.casillas}}{{#if this}}<td class="marca-plan">X</td>{{else}}<td class="nl"></td>{{/if}}{{/each}}
      <td>{{this.evidencias}}</td>
    </tr>
    {{/each}}
  </table>
  </div>
  {{/if}}

  {{> cierre-oficial}}
</td></tr></tbody>
</table>
</body>
</html>
