<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Ficha de monitoreo al docente</title>
  <style>
    :root {
      --azul: #c5d9f1;
      --azul-medio: #b8cce4;
      --azul-suave: #dce6f1;
      --gris: #d9d9d9;
      --linea: #000;
    }
    * { box-sizing: border-box; }
    html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    body {
      margin: 0;
      font-family: Carlito, Calibri, 'Liberation Sans', Arial, sans-serif;
      font-size: 12px;
      line-height: 1.25;
      color: #000;
    }

    .titulo { margin: 6px 0 4px; text-align: center; font-size: 17px; font-weight: bold; text-transform: uppercase; }
    .seccion { margin: 8px 0 1px; font-size: 13px; font-weight: bold; text-transform: uppercase; text-decoration: underline; break-after: avoid; }
    .seccion.centrada { text-align: center; text-decoration: none; margin-top: 10px; }

    table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    td, th { border: 1px solid var(--linea); padding: 2px 4px; vertical-align: middle; overflow-wrap: anywhere; }
    tr { break-inside: avoid; }
    .l { font-weight: bold; text-transform: uppercase; font-size: 11.5px; }
    .centro { text-align: center; }
    .negrita { font-weight: bold; }
    .relleno { background: var(--azul-suave); font-weight: bold; text-align: center; }
    .chk { text-align: center; font-weight: bold; }

    .monitor-opciones { float: right; font-weight: bold; text-transform: uppercase; font-size: 11.5px; }

    .lineamiento {
      margin: 6px 0 0; padding: 2px 6px; background: var(--azul-medio); border: 1px solid var(--linea);
      font-weight: bold; font-size: 10.5px; text-align: center;
    }
    .aula {
      margin: 0 0 6px; padding: 5px; background: var(--gris); border: 1px solid var(--linea);
      text-align: center; font-weight: bold; font-style: italic; font-size: 15px; text-transform: uppercase;
    }

    /* ── Desempeño ── */
    .desempeno { margin-bottom: 10px; }
    .desempeno td { vertical-align: top; }
    .d-titulo { background: var(--azul); font-weight: bold; text-transform: uppercase; font-size: 12.5px; padding: 3px 5px; break-after: avoid; }
    .d-bloque { background: var(--azul); padding: 3px 6px; text-align: justify; }
    .d-bloque ul { margin: 2px 0 0 18px; padding: 0; }
    .d-bloque li { margin: 1px 0; }
    .desempeno .nivel-vertical { background: var(--azul-medio); text-align: center; vertical-align: middle; width: 4%; }
    .nivel-vertical span { display: inline-block; writing-mode: vertical-rl; transform: rotate(180deg); font-weight: bold; letter-spacing: 1px; }
    .d-cabecera { background: var(--azul); font-weight: bold; text-align: center; font-size: 11.5px; }
    .romano { text-align: center; font-size: 11px; width: 4%; vertical-align: top; }
    .rubrica-texto { text-align: justify; font-size: 11.5px; }
    .libre, .gris, .marca { width: 6.5%; text-align: center; font-weight: bold; font-size: 15px; }
    .gris { background: var(--gris); }
    .marca { background: #fff; }
    .pregunta td { font-style: italic; font-size: 11.5px; }
    .pregunta .si-no { text-align: right; font-weight: bold; font-style: normal; white-space: nowrap; }
    .casilla { display: inline-block; min-width: 14px; height: 13px; border-bottom: 1px solid #000; text-align: center; line-height: 13px; vertical-align: baseline; }

    .evidencias-titulo { font-weight: bold; text-transform: uppercase; font-size: 11.5px; margin-bottom: 1px; }
    .renglones {
      min-height: 54px; line-height: 18px; white-space: pre-line; padding: 0 2px;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='8' height='18'><line x1='0' y1='17.5' x2='8' y2='17.5' stroke='%23222' stroke-width='1.2' stroke-dasharray='1 2'/></svg>");
      background-repeat: repeat;
    }

    /* ── Planificación ── */
    .plan th { background: var(--azul-suave); font-weight: bold; text-align: center; font-size: 11.5px; }
    .plan td { height: 62px; vertical-align: top; }
    .plan .r { width: 5%; text-align: center; vertical-align: middle; }
    .plan .eje { width: 28%; }
    .plan .nl { width: 5%; text-align: center; font-weight: bold; font-size: 15px; vertical-align: middle; }
    .plan .marca-plan { text-align: center; font-weight: bold; font-size: 15px; vertical-align: middle; }

    .caja { border: 1px solid var(--linea); padding: 3px 5px; margin-bottom: 4px; }
    .caja .renglones { min-height: 72px; }
    .etiqueta-caja { font-weight: bold; text-transform: uppercase; margin-top: 4px; }

    .consolidado .cab { background: var(--azul-suave); text-align: center; font-weight: bold; }
    .consolidado td { text-align: center; }
    .leyenda { width: 62%; margin-top: 8px; }
    .leyenda-titulo { font-weight: bold; font-size: 11px; margin-top: 8px; }
    .leyenda th { background: var(--azul-suave); font-size: 10.5px; font-weight: bold; }
    .leyenda td { text-align: center; font-size: 10.5px; padding: 1px 4px; }

    .evidencias-fotos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 4px 3px 0 0; }
    .evidencias-fotos figure { margin: 0; border: 1px solid var(--linea); padding: 4px; text-align: center; break-inside: avoid; }
    .evidencia-img { max-width: 100%; max-height: 230px; object-fit: contain; }
    .evidencias-fotos figcaption { font-size: 10px; margin-top: 2px; }

    .firmas { display: flex; justify-content: center; gap: 40px; margin-top: 18px; break-inside: avoid; }
    .firma { flex: 1; max-width: 280px; text-align: center; }
    .firma .trazo { height: 70px; display: flex; align-items: flex-end; justify-content: center; }
    .firma-img { max-height: 66px; max-width: 220px; }
    .firma .linea { border-top: 1px solid #000; padding-top: 3px; }
    .firma .rol { font-weight: bold; text-transform: uppercase; font-size: 11px; }
    .firma .fecha { font-size: 10px; }
    .bloque { break-inside: avoid; }

    /* ── Envoltura: el banner vive en el thead y el navegador lo repite en cada página ── */
    .envoltura, .envoltura > thead > tr > td, .envoltura > tbody > tr > td { border: none; padding: 0; }
    .envoltura > tbody > tr { break-inside: auto; }
    thead { display: table-header-group; }
    .banner { display: flex; align-items: stretch; gap: 3px; height: 44px; }
    .banner .caja { display: flex; flex-direction: column; justify-content: center; padding: 2px 8px; background: #1f4f9c; color: #fff; line-height: 1.1; }
    .banner .caja b { font-size: 12px; }
    .banner .gobierno { flex: 0 0 20%; }
    .banner .direccion, .banner .gestion { flex: 0 0 24%; }
    .banner .logos { flex: 1; display: flex; align-items: center; justify-content: space-around; }
    .banner .logo { height: 40px; width: auto; }
    .lema { margin: 2px 0 6px; text-align: center; font-style: italic; font-size: 12px; }
  </style>
</head>
<body>
<table class="envoltura">
<thead><tr><td>
  <div class="banner">
    <div class="caja gobierno"><b>GOBIERNO</b><b>REGIONAL PUNO</b></div>
    <div class="caja direccion"><b>Dirección</b><b>Regional de Educación</b></div>
    <div class="caja gestion"><b>Dirección de</b><b>Gestión Pedagógica</b></div>
    <div class="logos">
      <img class="logo" src="{{{logoUgel}}}" alt="UGEL Lampa">
      <img class="logo" src="{{{logoAgp}}}" alt="Área de Gestión Pedagógica">
    </div>
  </div>
  {{#if lema}}<div class="lema">&ldquo;{{lema}}&rdquo;</div>{{/if}}
</td></tr></thead>
<tbody><tr><td>

  <div class="titulo">FICHA DE MONITOREO AL DOCENTE {{anio}}</div>

  <div class="seccion">DATOS DE LA INSTITUCIÓN EDUCATIVA:</div>
  <table>
    <tr><td class="l" colspan="2">UGEL:</td><td colspan="10">UGEL LAMPA</td></tr>
    <tr><td class="l" colspan="2">INSTITUCIÓN EDUCATIVA:</td><td colspan="10">{{institucion.nombre}}</td></tr>
    <tr>
      <td class="l" colspan="2">MODALIDAD:</td><td colspan="2">{{institucion.modalidad}}</td>
      <td class="l" colspan="2">NIVEL:</td><td colspan="2">{{institucion.nivel}}</td>
      <td class="l" colspan="2">ÁREA:</td><td colspan="2">{{docente.area}}</td>
    </tr>
    <tr><td class="l" colspan="4">APELLIDOS Y NOMBRES DEL DIRECTOR(A):</td><td colspan="8">{{director.nombre}}</td></tr>
    <tr>
      <td class="l" colspan="2">DNI:</td><td colspan="2">{{director.dni}}</td>
      <td class="l" colspan="2">E-MAIL:</td><td colspan="2">{{director.correo}}</td>
      <td class="l" colspan="2">N° CELULAR:</td><td colspan="2">{{director.celular}}</td>
    </tr>
    <tr>
      <td class="l" colspan="2">ENCARGADO:</td><td class="chk" colspan="2">{{#if director.encargado}}X{{/if}}</td>
      <td class="l" colspan="2">DESIGNADO:</td><td class="chk" colspan="2">{{#if director.designado}}X{{/if}}</td>
      <td class="l" colspan="2">ENC. X FUNCIONES:</td><td class="chk" colspan="2">{{#if director.porFunciones}}X{{/if}}</td>
    </tr>
  </table>

  <div class="seccion">DATOS DEL DOCENTE MONITOREADO:</div>
  <table>
    <tr><td class="l" colspan="4">APELLIDOS Y NOMBRES DEL DOCENTE:</td><td colspan="8">{{docente.nombre}}</td></tr>
    <tr>
      <td class="l" colspan="2">DNI:</td><td colspan="2">{{docente.dni}}</td>
      <td class="l" colspan="2">E-MAIL:</td><td colspan="2">{{docente.correo}}</td>
      <td class="l" colspan="2">N° CELULAR:</td><td colspan="2">{{docente.celular}}</td>
    </tr>
    <tr>
      <td class="l" colspan="2">CONTRATADO:</td><td class="chk" colspan="2">{{#if docente.contratado}}X{{/if}}</td>
      <td class="l" colspan="2">NOMBRADO:</td><td class="chk" colspan="2">{{#if docente.nombrado}}X{{/if}}</td>
      <td class="l" colspan="2">OTRO:</td><td class="chk" colspan="2">{{#if docente.otro}}X{{/if}}</td>
    </tr>
    <tr>
      <td class="l" colspan="2">MODALIDAD:</td><td colspan="2">{{docente.modalidad}}</td>
      <td class="l" colspan="2">NIVEL:</td><td colspan="2">{{docente.nivel}}</td>
      <td class="l" colspan="2">ÁREA:</td><td colspan="2">{{docente.area}}</td>
    </tr>
    <tr>
      <td class="l" colspan="2">GRADO:</td><td colspan="1">{{docente.grado}}</td>
      <td class="l" colspan="2">SECCIÓN:</td><td colspan="1">{{docente.seccion}}</td>
      <td class="l" colspan="3">CANT. ESTUDIANTES:</td><td colspan="1">{{docente.estudiantes}}</td>
      <td class="l" colspan="1">NEE</td><td colspan="1">{{docente.nee}}</td>
    </tr>
  </table>

  <div class="seccion">DATOS DEL(OS) MONITOR(ES):</div>
  <table>
    <tr>
      <td class="l" colspan="3">APELLIDOS Y NOMBRES:</td>
      <td colspan="9">
        {{monitor.nombre}}
        <span class="monitor-opciones">
          DREP ( {{#if monitor.drep}}X{{else}}&nbsp;{{/if}} ) &nbsp;
          UGEL ( {{#if monitor.ugel}}X{{else}}&nbsp;{{/if}} ) &nbsp;
          DIRECTOR IE ( {{#if monitor.directorIe}}X{{else}}&nbsp;{{/if}} ) &nbsp;
          COORDINADOR ( {{#if monitor.coordinador}}X{{else}}&nbsp;{{/if}} )
        </span>
      </td>
    </tr>
    <tr>
      <td class="l" colspan="2">DNI:</td><td colspan="2">{{monitor.dni}}</td>
      <td class="l" colspan="2">E-MAIL:</td><td colspan="2">{{monitor.correo}}</td>
      <td class="l" colspan="2">N° CELULAR:</td><td colspan="2">{{monitor.celular}}</td>
    </tr>
  </table>

  <div class="seccion">FECHA Y DURACIÓN:</div>
  <table>
    <tr>
      <td class="l" colspan="1">FECHA:</td><td colspan="3">{{fecha}}</td>
      <td class="l" colspan="2">HORA INICIO:</td><td colspan="2">{{horaInicio}}</td>
      <td class="l" colspan="2">HORA FINAL:</td><td colspan="2">{{horaFinal}}</td>
    </tr>
  </table>

  <div class="seccion centrada">NIVELES DEL LOGRO:</div>
  <table>
    <tr>{{#each niveles}}<td class="relleno">NIVEL {{this.romano}}</td>{{/each}}</tr>
    <tr>{{#each niveles}}<td class="centro">{{this.denominacion}}</td>{{/each}}</tr>
  </table>

  <div class="lineamiento">LINEAMIENTO 2: Docentes mejoran su desempeño a través de la formación continua para lograr el nivel satisfactorio en el logro de los aprendizajes</div>
  <div class="aula">OBSERVACIÓN DE AULA</div>

  {{#each desempenos}}
  <table class="desempeno">
    <colgroup><col style="width:4%"><col style="width:4%"><col style="width:66%"><col style="width:6.5%"><col style="width:6.5%"><col style="width:6.5%"><col style="width:6.5%"></colgroup>
    <tr><td class="d-titulo" colspan="7">{{this.nombre}}</td></tr>
    <tr><td class="d-bloque" colspan="7"><b>Descripción del desempeño:</b><br>{{this.descripcion}}</td></tr>
    <tr>
      <td class="d-bloque" colspan="7">
        <b>{{this.introAspectos}}</b>
        <ul>{{#each this.aspectos}}<li>{{this}}</li>{{/each}}</ul>
      </td>
    </tr>
    <tr>
      <td class="nivel-vertical" rowspan="{{rowspanNivel this}}"><span>NIVEL</span></td>
      <td class="d-cabecera" colspan="2" rowspan="2">DESCRIPCIÓN DEL NIVEL A QUE CORRESPONDE<br>(Marcar sólo un nivel de desempeño)</td>
      <td class="d-cabecera" colspan="4">NIVELES</td>
    </tr>
    <tr><td class="d-cabecera">I</td><td class="d-cabecera">II</td><td class="d-cabecera">III</td><td class="d-cabecera">IV</td></tr>
    {{#each this.rubrica}}
    <tr>
      <td class="romano">{{this.romano}}</td>
      <td class="rubrica-texto">{{this.descripcion}}</td>
      {{#each this.celdas}}{{#if (eq this "marcada")}}<td class="marca">X</td>{{else}}{{#if (eq this "gris")}}<td class="gris"></td>{{else}}<td class="libre"></td>{{/if}}{{/if}}{{/each}}
    </tr>
    {{/each}}
    {{#if this.preguntaExtra}}
    <tr class="pregunta">
      <td colspan="5">{{this.preguntaExtra.texto}}</td>
      <td class="si-no" colspan="2">Sí: <span class="casilla">{{#if this.preguntaExtra.si}}X{{/if}}</span> &nbsp; No: <span class="casilla">{{#if this.preguntaExtra.no}}X{{/if}}</span></td>
    </tr>
    {{/if}}
    <tr>
      <td colspan="7">
        <div class="evidencias-titulo">EVIDENCIAS (CONDUCTAS OBSERVADAS)</div>
        <div class="renglones">{{this.evidencias}}</div>
      </td>
    </tr>
  </table>
  {{/each}}

  {{#if planificacion.length}}
  <div class="bloque">
  <div class="seccion centrada" style="text-align:left; font-size:15px; text-decoration:none; margin-top:14px;">PLANIFICACIÓN Y DISEÑO DE EVALUACIÓN</div>
  <table class="plan">
    <tr>
      <th rowspan="2" style="width:5%">R</th>
      <th rowspan="2" style="width:28%">EJES E ITEMS</th>
      <th colspan="4">NIVEL DE LOGRO</th>
      <th rowspan="2">EVIDENCIAS</th>
    </tr>
    <tr><th style="width:5%">I</th><th style="width:5%">II</th><th style="width:5%">III</th><th style="width:5%">IV</th></tr>
    {{#each planificacion}}
    <tr>
      <td class="r">{{this.numero}}</td>
      <td class="eje">{{this.descripcion}}</td>
      {{#each this.casillas}}{{#if this}}<td class="marca-plan">X</td>{{else}}<td class="nl"></td>{{/if}}{{/each}}
      <td>{{this.evidencias}}</td>
    </tr>
    {{/each}}
  </table>
  </div>
  {{/if}}

  <div class="bloque">
    <div class="seccion" style="margin-top:16px;">SUGERENCIAS Y COMPROMISOS:</div>
    {{#if observaciones}}
    <div class="etiqueta-caja">OBSERVACIONES GENERALES:</div>
    <div class="caja"><div class="renglones">{{observaciones}}</div></div>
    {{/if}}
    <div class="etiqueta-caja">SUGERENCIAS:</div>
    <div class="caja"><div class="renglones">{{sugerencias}}</div></div>
    <div class="etiqueta-caja">COMPROMISOS:</div>
    <div class="caja"><div class="renglones">{{compromisos}}</div></div>
  </div>

  <div class="bloque">
    <div class="seccion" style="margin-top:12px;">CONSOLIDADO DE NIVELES DE LOGRO:</div>
    <table class="consolidado">
      <tr>
        <td class="cab" style="width:14%">ASPECTOS</td>
        {{#each consolidado.columnas}}<td class="cab">{{this.etiqueta}}</td>{{/each}}
      </tr>
      <tr>
        <td class="cab">PUNTAJE</td>
        {{#each consolidado.columnas}}<td>{{this.puntaje}}</td>{{/each}}
      </tr>
      <tr><td class="cab">TOTAL</td><td colspan="{{consolidado.columnas.length}}" class="negrita">{{consolidado.total}}</td></tr>
      <tr><td class="cab">PROMEDIO</td><td colspan="{{consolidado.columnas.length}}" class="negrita" data-consolidado="promedio">{{consolidado.promedio}}</td></tr>
      <tr><td class="cab">NIVEL DE LOGRO</td><td colspan="{{consolidado.columnas.length}}" class="negrita" data-consolidado="nivel">{{consolidado.nivel}}</td></tr>
    </table>
    <div class="leyenda-titulo">LEYENDA</div>
    <table class="leyenda">
      <tr><th>TOTAL</th><th>PROMEDIO</th><th>NIVEL DE LOGRO ALCANZADO</th></tr>
      {{#each leyenda}}<tr><td>{{this.total}}</td><td>{{this.promedio}}</td><td>{{this.nivel}}</td></tr>{{/each}}
    </table>
  </div>

  {{#if evidencias.length}}
  <div class="seccion" style="margin-top:14px;">EVIDENCIAS DEL MONITOREO:</div>
  <div class="evidencias-fotos">
    {{#each evidencias}}
    <figure><img class="evidencia-img" src="{{this}}" alt="Evidencia"><figcaption>Evidencia {{increment @index}}</figcaption></figure>
    {{/each}}
  </div>
  {{/if}}

  <div class="firmas">
    {{#each firmas}}
    <div class="firma">
      <div class="trazo">{{#if this.imagen}}<img class="firma-img" src="{{this.imagen}}" alt="Firma">{{/if}}</div>
      <div class="linea">
        <div class="rol">{{this.rol}}</div>
        <div class="negrita">{{this.nombre}}</div>
        <div class="fecha">Firmado el {{this.fecha}}</div>
      </div>
    </div>
    {{/each}}
  </div>

</td></tr></tbody>
</table>
</body>
</html>
