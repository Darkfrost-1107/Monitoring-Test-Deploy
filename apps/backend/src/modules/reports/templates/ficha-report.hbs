<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Ficha de Monitoreo</title>
  <style>
    :root {
      --azul: #1e3a8a;
      --azul-claro: #eff6ff;
      --texto: #0f172a;
      --suave: #64748b;
      --borde: #cbd5e1;
      --fondo-etiqueta: #f1f5f9;
    }
    * { box-sizing: border-box; }
    body {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 10.5px;
      line-height: 1.4;
      color: var(--texto);
      margin: 0;
    }

    /* ── Encabezado institucional ── */
    .encabezado {
      display: flex;
      align-items: center;
      gap: 14px;
      padding-bottom: 10px;
      border-bottom: 3px solid var(--azul);
    }
    .logo { height: 52px; width: auto; }
    .institucional { flex: 1; }
    .institucional .linea-1 { font-size: 12px; font-weight: bold; color: var(--azul); letter-spacing: 0.4px; }
    .institucional .linea-2 { font-size: 9.5px; color: var(--suave); }
    .lema { text-align: center; font-style: italic; color: var(--suave); font-size: 9px; margin: 8px 0 0; }

    .titulo {
      margin: 12px 0 14px;
      padding: 8px 12px;
      background: var(--azul);
      color: #fff;
      text-align: center;
      font-size: 13px;
      font-weight: bold;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      border-radius: 4px;
    }

    /* ── Secciones ── */
    .seccion { margin-bottom: 12px; break-inside: avoid; }
    .seccion-titulo {
      margin: 0 0 4px;
      padding-left: 7px;
      border-left: 4px solid var(--azul);
      font-size: 10.5px;
      font-weight: bold;
      color: var(--azul);
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    th, td { border: 1px solid var(--borde); padding: 5px 7px; vertical-align: top; overflow-wrap: anywhere; }
    th {
      background: var(--azul);
      color: #fff;
      font-size: 9.5px;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }
    td.etiqueta {
      background: var(--fondo-etiqueta);
      font-weight: bold;
      font-size: 9.5px;
      color: #334155;
      text-transform: uppercase;
    }
    .centrado { text-align: center; }

    /* Las tablas largas repiten su encabezado y no parten una fila entre páginas */
    thead { display: table-header-group; }
    tr { break-inside: avoid; }
    tbody tr:nth-child(even) td:not(.etiqueta) { background: #f8fafc; }

    /* ── Niveles de logro ── */
    .leyenda td { font-size: 9px; color: #334155; text-align: center; }
    .leyenda th { font-size: 9px; line-height: 1.3; }
    .leyenda th.nivel-1 { background: #dc2626; }
    .leyenda th.nivel-2 { background: #d97706; }
    .leyenda th.nivel-3 { background: #16a34a; }
    .leyenda th.nivel-4 { background: #2563eb; }

    .nivel-badge {
      display: inline-block;
      min-width: 22px;
      padding: 2px 7px;
      border-radius: 10px;
      color: #fff;
      font-weight: bold;
      text-align: center;
    }
    .nivel-badge.nivel-1 { background: #dc2626; }
    .nivel-badge.nivel-2 { background: #d97706; }
    .nivel-badge.nivel-3 { background: #16a34a; }
    .nivel-badge.nivel-4 { background: #2563eb; }

    /* ── Consolidado ── */
    .consolidado { display: flex; gap: 8px; }
    .indicador {
      flex: 1;
      padding: 8px 6px;
      text-align: center;
      background: var(--azul-claro);
      border: 1px solid #bfdbfe;
      border-radius: 6px;
    }
    .indicador .rotulo { font-size: 8.5px; color: var(--suave); text-transform: uppercase; letter-spacing: 0.4px; }
    .indicador .valor { margin-top: 3px; font-size: 15px; font-weight: bold; color: var(--azul); }

    .texto-libre { min-height: 60px; padding: 8px 10px; border: 1px solid var(--borde); border-radius: 4px; white-space: pre-line; }
    .vacio { color: var(--suave); font-style: italic; }

    /* ── Firmas ── */
    .firmas { display: flex; justify-content: center; gap: 28px; margin-top: 8px; break-inside: avoid; }
    .firma { flex: 1; max-width: 260px; text-align: center; }
    .firma img { display: block; margin: 0 auto 4px; max-height: 80px; max-width: 200px; }
    .firma .linea { border-top: 1px solid var(--texto); padding-top: 4px; font-size: 10px; }
    .firma .fecha { font-size: 8.5px; color: var(--suave); }
  </style>
</head>
<body>

  <div class="encabezado">
    <img class="logo" src="{{{logoUgel}}}" alt="UGEL Lampa">
    <div class="institucional">
      <div class="linea-1">GOBIERNO REGIONAL PUNO</div>
      <div class="linea-2">Dirección Regional de Educación · Dirección de Gestión Pedagógica</div>
    </div>
  </div>
  <div class="lema">Año de la recuperación y consolidación de la economía peruana</div>

  <div class="titulo">Ficha de Monitoreo · {{ficha.anioAcademico}}</div>

  <div class="seccion">
    <div class="seccion-titulo">Datos de la institución educativa y docente</div>
    <table>
      <tr>
        <td class="etiqueta" width="22%">Institución educativa</td>
        <td width="48%">{{institucion.nombre}}</td>
        <td class="etiqueta" width="15%">Cód. modular</td>
        <td width="15%">{{institucion.codigoModular}}</td>
      </tr>
      <tr>
        <td class="etiqueta">Apellidos y nombres</td>
        <td colspan="3">{{docente.nombres}} {{docente.apellidoPaterno}} {{docente.apellidoMaterno}}</td>
      </tr>
      <tr>
        <td class="etiqueta">DNI</td>
        <td>{{docente.dni}}</td>
        <td class="etiqueta">Celular</td>
        <td>{{docente.telefono}}</td>
      </tr>
    </table>
  </div>

  <div class="seccion">
    <div class="seccion-titulo">Datos del monitor</div>
    <table>
      <tr>
        <td class="etiqueta" width="22%">Apellidos y nombres</td>
        <td colspan="3">{{monitor.nombres}} {{monitor.apellidoPaterno}} {{monitor.apellidoMaterno}}</td>
      </tr>
      <tr>
        <td class="etiqueta">Cargo</td>
        <td width="38%">Especialista en Educación</td>
        <td class="etiqueta" width="12%">Fecha</td>
        <td>{{fechaFormat}}</td>
      </tr>
    </table>
  </div>

  <div class="seccion">
    <div class="seccion-titulo">Niveles del logro</div>
    <table class="leyenda">
      <tr>
        <th class="nivel-1">Nivel I<br>Inicio</th>
        <th class="nivel-2">Nivel II<br>En proceso</th>
        <th class="nivel-3">Nivel III<br>Logro esperado</th>
        <th class="nivel-4">Nivel IV<br>Logro destacado</th>
      </tr>
      <tr>
        <td>Presenta deficiencias significativas o ausencia de la habilidad.</td>
        <td>Evidencia avances, pero con limitaciones.</td>
        <td>Cumple los criterios de manera adecuada.</td>
        <td>Supera el nivel esperado con un desempeño sólido.</td>
      </tr>
    </table>
  </div>

  <div class="seccion" style="break-inside: auto;">
    <div class="seccion-titulo">Rúbricas de monitoreo</div>
    <table>
      <thead>
        <tr>
          <th width="6%">N°</th>
          <th width="46%">Rúbricas / desempeños</th>
          <th width="10%">Nivel</th>
          <th width="38%">Observaciones</th>
        </tr>
      </thead>
      <tbody>
        {{#each respuestas}}
        <tr>
          <td class="centrado">{{increment @index}}</td>
          <td>{{this.nombre}}</td>
          <td class="centrado"><span class="nivel-badge nivel-{{this.nivel}}">{{this.nivel}}</span></td>
          <td>{{this.observaciones}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <div class="seccion">
    <div class="seccion-titulo">Consolidado niveles de logro</div>
    <div class="consolidado">
      <div class="indicador"><div class="rotulo">Nivel alcanzado</div><div class="valor">{{humanizar ficha.nivelLogro}}</div></div>
      <div class="indicador"><div class="rotulo">Puntaje total</div><div class="valor">{{ficha.puntajeTotal}}</div></div>
      <div class="indicador"><div class="rotulo">Promedio</div><div class="valor">{{ficha.promedio}}</div></div>
      <div class="indicador"><div class="rotulo">Estado</div><div class="valor">{{humanizar ficha.estado}}</div></div>
    </div>
  </div>

  <div class="seccion">
    <div class="seccion-titulo">Observaciones y sugerencias del monitor</div>
    <div class="texto-libre">{{#if ficha.observaciones}}{{ficha.observaciones}}{{else}}<span class="vacio">Ninguna registrada.</span>{{/if}}{{#if ficha.sugerencias}}

<strong>Sugerencias:</strong>
{{ficha.sugerencias}}{{/if}}</div>
  </div>

  <div class="seccion">
    <div class="seccion-titulo">Compromisos de mejora</div>
    <div class="texto-libre">{{#if ficha.compromisos}}{{ficha.compromisos}}{{else}}<span class="vacio">Ningún compromiso registrado.</span>{{/if}}</div>
  </div>

  <div class="seccion">
    <div class="seccion-titulo">Firmas digitales</div>
    <div class="firmas">
      {{#each firmas}}
      <div class="firma">
        {{#if this.imagenB64}}<img src="{{this.imagenB64}}" alt="Firma">{{/if}}
        <div class="linea">
          <b>Firma del {{this.rolFirmante}}</b><br>
          {{this.firmanteNombre}}<br>
          <span class="fecha">Firmado el {{this.fechaFirma}}</span>
        </div>
      </div>
      {{/each}}
      {{#unless firmas}}
      <span class="vacio">Sin firmas registradas.</span>
      {{/unless}}
    </div>
  </div>

</body>
</html>
